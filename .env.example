# Copy this file to .env to run the host venv against a real Postgres
# (any Docker Postgres/PostGIS container works, e.g. "pg_dev") instead of
# the default sqlite. Never set DJANGO_USE_GIS here -- see config/settings.py.
#
# cp .env.example .env

DJANGO_DB_HOST=localhost
DJANGO_DB_PORT=5432
DJANGO_DB_NAME=payments_demo
DJANGO_DB_USER=demo
DJANGO_DB_PASSWORD=demo

# Only needed if your mongo/pubsub-emulator containers publish non-default
# ports -- demo_mongo_telemetry.py and demo_pubsub_delivery.py already
# default to localhost:27017 and localhost:8085.
# MONGO_URL=mongodb://localhost:27017
# PUBSUB_EMULATOR_HOST=localhost:8085
